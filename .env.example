NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Upstash Redis (free tier — https://upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cobros ─────────────────────────────────────────────────────────────
# Proveedor activo: visanet | vanapay | paggo | none (por defecto, sin cobros
# en línea: el tier se otorga a mano desde lex-extractor).
PAYMENT_PROVIDER=none

# Solo la ruta del webhook usa esta llave, y salta RLS. Nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Credenciales del proveedor que se active (ver lib/billing/providers/*.ts)
VISANET_MERCHANT_ID=
VISANET_API_KEY=
VISANET_WEBHOOK_SECRET=
VANAPAY_MERCHANT_ID=
VANAPAY_API_KEY=
VANAPAY_WEBHOOK_SECRET=
PAGGO_MERCHANT_ID=
PAGGO_API_KEY=
PAGGO_WEBHOOK_SECRET=

# ── Facturación electrónica (FEL) ──────────────────────────────────────
# Certificador: infile | none
FEL_CERTIFIER=none
FEL_NIT_EMISOR=
INFILE_USER=
INFILE_KEY=
INFILE_TOKEN=
